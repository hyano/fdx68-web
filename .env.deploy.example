# 開発用デプロイ設定
# このファイルを .env.deploy にコピーして、自分の環境に合わせて書き換えてください。
# .env.deploy は git 管理外です（接続情報を公開リポジトリに残さないため）。

# デプロイ先の SSH ホスト（~/.ssh/config のホスト名、または user@host 形式）
DEPLOY_HOST=pi@raspberrypi.local

# デプロイ先のディレクトリ
DEPLOY_DIR=/home/pi/fdx68-web

# 疎通確認に使う URL
HEALTH_URL=http://raspberrypi.local:8000/api/health
