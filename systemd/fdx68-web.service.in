# FDX68 Web Controller の systemd unit テンプレート。
# @PLACEHOLDER@ は scripts/install.sh が実際の値に置き換える。
# 直接編集せず、install.sh を再実行すること。

[Unit]
Description=FDX68 Web Controller
Documentation=https://github.com/hyano/fdx68-web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# root では動かさない。root 権限が必要な操作だけ sudo -n で実行する。
User=@USER@
Group=@GROUP@

WorkingDirectory=@APP_DIR@
ExecStart=@APP_DIR@/.venv/bin/uvicorn app.main:app --host @HOST@ --port @PORT@

Restart=on-failure
RestartSec=5

# 停止時にシグナルを送る範囲を、この unit の主プロセス（uvicorn）だけに限定する。
#
# 既定の KillMode=control-group では cgroup 内の全プロセスにシグナルが飛ぶため、
# アプリが起動した fddemu も一緒に落ちる。start_new_session=True で起動していても
# セッションが分かれるだけで cgroup からは抜けないため、これを避けられない。
#
# fddemu は X68000 から見えているフロッピードライブそのものであり、
# Web UI の再起動やデプロイのたびにドライブが消えるのは受け入れられない。
# アプリは fddemu を PID ではなく pgrep -x で発見するので、
# サービスをまたいで生き残っていてもそのまま制御できる。
#
# なお systemctl stop でも fddemu は残る。止めたいときは Web UI か fddctl --stop を使う。
KillMode=process

# ロケールを明示的に固定する。
#
# Debian の /etc/default/locale は PAM 経由のログインセッションに適用されるもので、
# systemd のシステムサービスには自動的には渡らない。ロケールが C のままだと
# Python のファイルシステムエンコーディングが期待通りにならず、
# 日本語ファイル名の FDX イメージを扱う際に破綻しうる。
#
# C.UTF-8 を選んでいるのは、ロケール生成の有無に依存せず常に利用可能で、
# かつ UTF-8 が保証されるため。表示言語はアプリ側で持っている。
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONUNBUFFERED=1

# 設定は .env から読む
EnvironmentFile=-@APP_DIR@/.env

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fdx68-web

[Install]
WantedBy=multi-user.target
