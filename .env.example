# FDX68 Web Controller の設定
# このファイルを .env にコピーして使います。.env は git 管理外です。

# バックエンドの選択
#   mock … 実際の FDX68 コマンドを呼ばず、メモリ上の状態を返す（macOS での開発用）
#   real … 実際の FDX68 コマンドを実行する（Raspberry Pi 用）
FDX68_BACKEND=mock

# ディスクイメージを置くディレクトリ。Web UI からはこの配下しか見えません。
# install.sh が実行ユーザーのホーム配下（$HOME/fdximg）に自動設定します。
FDX68_IMAGE_DIR=/home/pi/fdximg

# FDX68 のコマンドが置かれているディレクトリ
FDX68_BIN_DIR=/usr/local/bin

# root 権限が必要なコマンド（fddemu / pkill / reboot / poweroff）を
# sudo -n 経由で実行するか。アプリ自体を root で動かす場合のみ false にします。
# fddctl は root 不要のため、この設定にかかわらず常に非 root で実行します。
FDX68_USE_SUDO=true

# fddctl -l で状態を取得する間隔（秒）。
# 短くすると反応が良くなりますが、fddemu のリアルタイム動作に影響しうるため
# 小さくしすぎないでください。
FDX68_STATUS_INTERVAL=2

# アップロード 1 ファイルあたりの上限（MB）
FDX68_MAX_UPLOAD_MB=256

# fddemu の起動オプション。空なら FDX68 の既定値（-o x1 -o q0 -o m1 -o c0）が使われます。
# 例: PC-9801 で使う場合は "-o q1"
FDX68_FDDEMU_OPTIONS=

# Web UI 起動時に fddemu も自動起動するか
FDX68_AUTOSTART_FDDEMU=true

# Web サーバの待ち受け設定
# 認証機能はないため、インターネットに公開しないでください。
FDX68_HOST=0.0.0.0
FDX68_PORT=8000
